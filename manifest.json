{
  "manifest_version": 3,
  "name": "Anime Skips",
  "version": "0.4.0",
  "icons": {
    "16": "extension/assets/icon-16.png",
    "32": "extension/assets/icon-32.png",
    "48": "extension/assets/icon-48.png",
    "128": "extension/assets/icon-128.png"
  },
  "description": "Guías de relleno para siete animes, diseños por serie, intros, resúmenes y velocidad. Netflix y Crunchyroll experimental.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "Anime Skips",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/assets/icon-16.png",
      "32": "extension/assets/icon-32.png",
      "48": "extension/assets/icon-48.png",
      "128": "extension/assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "extension/data/episodes.js",
        "extension/data/netflix-catalog.js",
        "extension/core.js",
        "extension/adapters.js",
        "extension/media.js",
        "extension/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": [
        "extension/data/episodes.js",
        "extension/core.js",
        "extension/adapters.js",
        "extension/media.js",
        "extension/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
