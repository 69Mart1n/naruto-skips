{
  "manifest_version": 3,
  "name": "Anime Skips",
  "version": "0.4.0",
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "description": "Guías de relleno para siete animes, diseños por serie, intros, resúmenes y velocidad. Netflix y Crunchyroll experimental.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Anime Skips", "default_popup": "popup.html", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" } },
  "content_scripts": [
    { "matches": ["https://www.netflix.com/*"], "js": ["data/episodes.js", "data/netflix-catalog.js", "core.js", "adapters.js", "media.js", "content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.crunchyroll.com/*", "https://static.crunchyroll.com/*"], "js": ["data/episodes.js", "core.js", "adapters.js", "media.js", "content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
