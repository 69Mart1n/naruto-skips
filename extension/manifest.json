{
  "manifest_version": 3,
  "name": "Naruto Skips",
  "version": "0.3.3",
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "description": "Naruto y Shippuden: guía personalizada, detección por episodio en Netflix, intros, resúmenes y velocidad de escenas.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Naruto Skips", "default_popup": "popup.html", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" } },
  "content_scripts": [
    { "matches": ["https://www.netflix.com/*"], "js": ["data/episodes.js", "data/netflix-catalog.js", "core.js", "adapters.js", "media.js", "content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.crunchyroll.com/*", "https://static.crunchyroll.com/*"], "js": ["data/episodes.js", "core.js", "adapters.js", "media.js", "content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
